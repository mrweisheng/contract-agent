# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/
.envrc

# ============ 敏感信息 ============
# 真实环境变量（含 LLM API Key），只提交 .env.example
.env
.env.local
.env.*.local

# ============ 运行时生成数据 ============
# SQLite 历史数据库
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

# 生成的合同文件（含客户隐私）
server/data/out/
# 测试残留输出（合同功能验证临时落盘，不入库）
server/data/test_out/

# 临时文件
tmp/
temp/
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
# Word/Excel 打开时的临时锁文件
~$*.docx
~$*.xlsx

# ============ 日志 ============
*.log
logs/
server/logs/

# ============ 编辑器 ============
.idea/
.vscode/
*.iml
*.suo
# Claude Code 本地工作产物（agent memory/artifacts）
.workbuddy/

# ============ Node（若有） ============
node_modules/
dist/
build/

# ============ 系统意外产物 ============
# Windows 保留设备名，会让 git 无法读取
server/nul